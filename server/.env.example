# Copy to server/.env for local overrides.
MONGODB_URI=mongodb://127.0.0.1:27017/spotter
# Required in production: signs photo and export URLs.
APP_SECRET=change-me
PORT=3000
# Origins allowed to call the API cross-origin (the iOS app is capacitor://localhost).
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost:5173
# Seeded bots that like back and reply. Defaults to on outside production.
# DEMO_MODE=true
# UPLOADS_DIR=data/uploads
# WEB_DIR=../client/dist
